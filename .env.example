# Local synthetic development requires no external database. Never store wallet keys.
FORKTRADE_MODE=offline
# Embedded PostgreSQL directory, used locally only when DATABASE_URL is absent.
FORKTRADE_LOCAL_DB=.local/offline-pg
# Vercel/Neon: set DATABASE_URL to the integration's pooled PostgreSQL URL.
# A hosted instance never falls back to a local file. See .env.vercel.example.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
FORKTRADE_ORIGIN=http://127.0.0.1:3000
# Wallet authentication and all transactions remain disabled.
FORKTRADE_AUTH_ENABLED=false
FORKTRADE_EXECUTION_ENABLED=false
# Only confirm after dated accepted-environment evidence; this is not a wallet grant.
FORKTRADE_ENVIRONMENT_CONFIRMED=false

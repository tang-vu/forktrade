# TESTNET PROFILE ONLY. Use a new database permanently bound to testnet data.
# These values describe the authorized hosted testnet profile; every order still
# requires the owner to approve the exact review and wallet request.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-TESTNET-NEON-POOLER-HOST/neondb?sslmode=verify-full
FORKTRADE_ORIGIN=https://forktrade.vercel.app
FORKTRADE_MODE=testnet
FORKTRADE_AUTH_ENABLED=true
FORKTRADE_EXECUTION_ENABLED=true
FORKTRADE_ENVIRONMENT_CONFIRMED=true

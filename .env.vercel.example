# TEMPLATE ONLY. Copy into Vercel environment settings, never commit real values.
# Connect Neon through the Vercel Marketplace; use its pooled URL at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
# Direct/unpooled URL is optional for the explicit migration command only.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/neondb?sslmode=require
FORKTRADE_ORIGIN=https://YOUR-PROJECT.vercel.app
# Start with a separate database/branch permanently bound to synthetic demo data.
FORKTRADE_MODE=offline
FORKTRADE_AUTH_ENABLED=false
FORKTRADE_EXECUTION_ENABLED=false
FORKTRADE_ENVIRONMENT_CONFIRMED=false
